# Local AI parts assistant (all optional; these are the code defaults).
# LLM_PROVIDER=ollama | mock  (mock = deterministic stub for e2e/CI)
LLM_PROVIDER=ollama
# Ollama runs on the host; the backend container reaches it via extra_hosts.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Fallback model: llama3.1:8b
OLLAMA_MODEL=qwen2.5:3b-instruct
# Per-request timeout to Ollama (ms); cold model load takes ~30s.
LLM_TIMEOUT_MS=120000
# How long Ollama keeps the model loaded between chats.
OLLAMA_KEEP_ALIVE=30m
# Wall-clock cap for one whole assistant reply (ms); on expiry the upstream call is aborted.
LLM_TURN_MAX_MS=150000
# Max assistant replies running at once across ALL users (extra requests get a friendly 503 assistant_busy).
LLM_MAX_CONCURRENT=2
